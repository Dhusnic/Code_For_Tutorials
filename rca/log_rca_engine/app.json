{
  "apps": [
    {
      "name": "log-rca-engine",
      "cwd": ".",
      "script": "./bin/log-rca-engine.exe",
      "args": [
        "--config",
        "./config/config.yml"
      ],
      "exec_mode": "fork",
      "instances": 1,
      "exec_interpreter": "none",
      "autorestart": true,
      "max_restarts": 10,
      "restart_delay": 5000,
      "combine_logs": true,
      "out_file": "./logs/log-rca-engine.out.log",
      "error_file": "./logs/log-rca-engine.err.log",
      "env": {
        "PM2_APP_NAME": "log-rca-engine"
      }
    }
  ]
}
