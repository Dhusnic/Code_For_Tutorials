  {
    "is_enabled": false,
    "id": "CORR_DOWN_NGINX_UNIT_TO_EDGE_IMPACT",
    "organization_id": "135098068173316952064",
    "rule_type": "ordered_signal_sequence",
    "description": "Detects nginx service-down conditions that impact users. How to replicate: stop nginx service (or force failed unit), then send HTTP traffic and observe 5xx responses.",
    "window": "12m",
    "max_gap_between_steps": "3m",
    "group_by": [
      "event.organization",
      "host.identity"
    ],
    "priority": 1,
    "sequence": [
      {
        "signal_key": "systemd_unit_failed",
        "min_count": 1,
        "within": "3m"
      },
      {
        "signal_key": "nginx_service_manager_failure",
        "min_count": 1,
        "within": "3m"
      },
      {
        "signal_key": "nginx_access_5xx_any",
        "min_count": 2,
        "within": "6m"
      }
    ],
    "not_sequence": [],
    "deduplication": {
      "key": [
        "signal_key",
        "host.name",
        "service.name"
      ],
      "window": "2m"
    },
    "topology_ids": [
      "topology_current"
    ]
  },
