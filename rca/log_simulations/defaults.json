        },
        {
          "id": "ifnet_link_state_down",
          "envelope": "rfc3164",
          "severity": "critical",
          "categories": ["switch", "router"],
          "message": "%%01IFNET/4/LINK_STATE(l)[{{pid}}]:The line protocol state on {{iface}} entered down state.",
