    "dell_os10": {
      "display_name": "Dell SmartFabric OS10 / PowerSwitch",
      "default_facility": 23,
      "default_severity_weights": { "critical": 0.25, "error": 0.40, "warning": 0.25, "info": 0.10 },
      "templates": [
        {
          "id": "bgp_neighbor_backward_state",
          "envelope": "rfc3164",
          "severity": "critical",
          "categories": ["switch", "router"],
          "static_ctx": { "old_state": "ESTABLISHED", "new_state": "IDLE", "vrf": "default" },
          "message": "{{dell_prefix}} %BGP_NBR_BKWD_STATE_CHG: Backward state change occurred for peer [{{peer_ip}}], vrf [{{vrf}}], old state [{{old_state}}], new state [{{new_state}}], event [ADJCHANGE: Hold Time expired] (model={{dell_model}}, os10={{dell_os10_version}})",
