    "crontab_cron": {
      "display_name": "CRON / Crontab scheduler logs (Linux-based network appliances)",
      "default_facility": 9,
      "default_severity_weights": { "critical": 0.20, "error": 0.25, "warning": 0.35, "info": 0.20 },
      "templates": [
        {
          "id": "cron_cmd_started",
          "envelope": "rfc3164",
          "severity": "info",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "CRON[{{pid}}]: ({{cron_user}}) CMD ({{cron_command}})",
          "weight": 1.3
        },
        {
          "id": "cron_cmd_completed",
          "envelope": "rfc3164",
          "severity": "info",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "CRON[{{pid}}]: ({{cron_user}}) END ({{cron_command}})",
          "weight": 0.9
        },
        {
          "id": "cron_daemon_fork_failure",
          "envelope": "rfc3164",
          "severity": "critical",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "CRON[{{pid}}]: (CRON) can't fork",
          "weight": 0.4
        },
        {
          "id": "cron_priv_drop_failure",
          "envelope": "rfc3164",
          "severity": "critical",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "CRON[{{pid}}]: ({{cron_user}}) ERROR (do_command:setuid({{cron_uid}}) failed: Permission denied)",
          "weight": 0.4
        },
        {
          "id": "cron_no_mta_output_discarded",
          "envelope": "rfc3164",
          "severity": "warning",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "CRON[{{pid}}]: ({{cron_user}}) No MTA installed, discarding output",
          "weight": 0.7
        },
        {
          "id": "cron_mail_delivery_failure",
          "envelope": "rfc3164",
          "severity": "warning",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "CRON[{{pid}}]: ({{cron_user}}) mailed {{bytes}} bytes of output but got status {{cron_mta_status}} from MTA",
          "weight": 0.5
        },
        {
          "id": "crontab_syntax_error",
          "envelope": "rfc3164",
          "severity": "warning",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "\"{{cron_file}}\":{{cron_line}}: bad minute",
          "weight": 0.6
        },
        {
          "id": "crontab_install_rejected",
          "envelope": "rfc3164",
          "severity": "critical",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "errors in crontab file, can't install.",
          "weight": 0.5
        },
        {
          "id": "cron_missing_newline_ignored",
          "envelope": "rfc3164",
          "severity": "warning",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "ERROR (Missing newline before EOF, this crontab file will be ignored)",
          "weight": 0.5
        },
        {
          "id": "cron_pam_session_opened",
          "envelope": "rfc3164",
          "severity": "info",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "pam_unix(cron:session): session opened for user {{cron_user}} by (uid={{cron_uid}})",
          "weight": 0.6
        },
        {
          "id": "cron_pam_session_closed",
          "envelope": "rfc3164",
          "severity": "info",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "pam_unix(cron:session): session closed for user {{cron_user}}",
          "weight": 0.6
        },
        {
          "id": "cron_pam_auth_failure",
          "envelope": "rfc3164",
          "severity": "warning",
          "categories": ["switch", "router", "security-appliance", "other"],
          "message": "pam_unix(cron:auth): authentication failure; logname= uid={{cron_uid}} euid={{cron_uid}} tty=cron ruser= rhost= user={{cron_user}}",
          "weight": 0.6
        }
      ]
    },
    "mikrotik_ros": {
      "display_name": "MikroTik RouterOS topics style",
      "default_facility": 3,
      "default_severity_weights": { "critical": 0.10, "error": 0.25, "warning": 0.25, "info": 0.40 },
      "templates": [
        {
          "id": "firewall_drop",
          "envelope": "rfc3164",
          "severity": "warning",
          "categories": ["router", "wireless"],
          "message": "firewall,info input: in:{{iface}} out:(none), src-mac {{src_mac}}, proto {{proto}}, {{src_ip}}:{{src_port}}->{{dst_ip_public}}:{{dst_port}}, len {{pkt_len}}",
          "weight": 1.0
        },
        {
          "id": "account_login",
          "envelope": "rfc3164",
          "severity": "info",
          "categories": ["router", "wireless"],
          "message": "system,info,account user {{username}} logged in from {{src_ip}} via ssh",
          "weight": 0.6
        }
      ]
    }
