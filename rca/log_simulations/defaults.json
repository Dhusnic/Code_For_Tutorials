{
  "version": 1,
  "target": {
    "host": "10.0.4.132",
    "port": 5046,
    "proto": "udp",
    "tcp_framing": "newline",
    "connect_timeout_s": 5.0,
    "reconnect_delay_s": 1.0
  },
  "runtime": {
    "rate": 5.0,
    "batch_size": 25,
    "count": 0,
    "dry_run": false,
    "include_pri": true,
    "timestamp_timezone": "local",
    "random_seed": 42
  },
  "categories": {
    "switch": true,
    "router": true,
    "firewall": true,
    "loadbalancer": true,
    "security-appliance": true,
    "wireless": true,
    "other": true
  },
  "defaults": {
    "facility": 23
  },
  "severity_weights": {
    "critical": 0.30,
    "error": 0.50,
    "warning": 0.15,
    "info": 0.05
  },
  "seed": {
    "private_ips": ["10.0.0.10", "10.0.10.25", "10.34.195.36", "192.168.88.90", "172.16.50.10"],
    "public_ips": ["1.1.1.1", "8.8.8.8", "9.9.9.9", "216.58.220.46"],
    "usernames": ["admin", "netops", "secops", "vty2"],
    "domains": ["example.com", "corp.example", "test.local"],
    "interfaces": {
      "cisco_ios": ["GigabitEthernet0/1", "GigabitEthernet0/2", "Port-channel1", "Vlan1"],
      "juniper_srx": ["ge-0/0/0.0", "ge-0/0/1.0", "st0.0"],
      "arista_eos": ["Ethernet1", "Ethernet23", "Port-Channel6"],
      "hpe_aruba": ["1/1/1", "1/1/2", "1/1/48", "lag10", "lag100", "vlan100"],
      "huawei_vrp": ["10GE1/0/1", "10GE1/0/2", "Eth-Trunk10", "GE0/0/1", "Vlanif100"],
      "dell_os10": ["Ethernet1/1/1", "Ethernet1/1/2", "Ethernet1/1/48", "Port-channel10", "Port-channel100", "mgmt1/1/1"],
      "crontab_cron": ["lo", "eth0", "mgmt0", "vlan100"],
      "mikrotik_ros": ["ether1", "ether8", "bridge", "vlan10"],
      "f5_bigip": ["tmm", "mcpd", "sod"],
      "default": ["eth0", "eth1"]
    },
    "zones": ["trust", "untrust", "inside", "outside"],
    "policies": ["default-deny", "policy-deny", "Allow-Internet", "Cleanup rule"],
    "apps": ["junos-ssh", "junos-dns-udp", "web-browsing", "ssl"],
    "messages": ["test message from console", "authentication failed", "disk usage high"],
    "commands": [
      "display current-configuration",
      "display interface brief",
      "display ospf peer",
      "display bgp peer",
      "interface 10GE1/0/1",
      "bgp 65000"
    ],
    "cron_users": ["root", "admin", "netops", "backup"],
    "cron_commands": [
      "/usr/local/bin/config-backup.sh",
      "/usr/local/bin/export-telemetry.sh --push",
      "/usr/sbin/logrotate /etc/logrotate.conf",
      "/usr/lib/sa/sa1 1 1",
      "/opt/dell/os10/scripts/health-check.sh"
    ],
    "cron_files": [
      "/etc/crontab",
      "/etc/cron.d/network-maintenance",
      "/etc/cron.d/telemetry-sync",
      "/var/spool/cron/root"
    ],
    "hpe_aruba_models": ["8360-48Y6C", "8325-48Y8C", "6300M", "6200F"],
    "hpe_aruba_versions": ["10.14.1000", "10.13.1040", "10.12.1050", "WC.16.11"],
    "aruba_central_hosts": ["device.arubanetworks.com:443", "east-device.arubanetworks.com:443"],
    "dell_models": ["S5248F-ON", "Z9432F-ON", "S5232F-ON", "S4148U-ON"],
    "dell_os10_versions": ["10.5.4.6", "10.5.5.3", "10.5.6.1"]
  },
  "vendors": {
    "cisco_ios": {
      "display_name": "Cisco IOS/NX-OS style",
      "default_facility": 23,
      "default_severity_weights": { "critical": 0.20, "error": 0.60, "warning": 0.15, "info": 0.05 },
      "templates": [
        {
          "id": "link_updown",
          "envelope": "rfc3164",
          "severity": "error",
          "categories": ["switch", "router", "wireless"],
          "message": "%LINK-3-UPDOWN: Interface {{iface}}, changed state to {{state}}",
          "weight": 2.0
        },
        {
          "id": "lineproto_updown",
          "envelope": "rfc3164",
          "severity": "warning",
          "categories": ["switch", "router"],
          "message": "%LINEPROTO-5-UPDOWN: Line protocol on Interface {{iface}}, changed state to {{state}}",
          "weight": 1.5
        },
        {
          "id": "config_i",
          "envelope": "rfc3164",
          "severity": "info",
          "categories": ["switch", "router"],
          "message": "%SYS-5-CONFIG_I: Configured from console by {{username}} ({{src_ip}})",
          "weight": 0.8
        },
        {
          "id": "mallocfail",
          "envelope": "rfc3164",
          "severity": "critical",
          "categories": ["switch", "router"],
          "message": "%SYS-2-MALLOCFAIL: Memory allocation of {{bytes}} bytes failed from 0x{{hex}}, alignment 0",
          "weight": 0.6
        }
      ]
    },
    "juniper_srx": {
      "display_name": "Juniper SRX RT_FLOW style",
      "default_facility": 23,
      "default_severity_weights": { "critical": 0.25, "error": 0.55, "warning": 0.15, "info": 0.05 },
      "templates": [
        {
          "id": "rt_flow_deny",
          "envelope": "rfc3164",
          "severity": "error",
          "categories": ["firewall", "security-appliance"],
          "message": "RT_FLOW: RT_FLOW_SESSION_DENY: session denied {{src_ip}}/{{src_port}}->{{dst_ip_public}}/{{dst_port}} {{app}} {{proto_num}}(0) {{policy}} {{zone_src}} {{zone_dst}} UNKNOWN UNKNOWN N/A(N/A) {{iface}} UNKNOWN policy deny",
          "weight": 2.0
        },
        {
          "id": "rt_flow_create",
          "envelope": "rfc3164",
          "severity": "info",
          "categories": ["firewall", "security-appliance"],
          "message": "RT_FLOW: RT_FLOW_SESSION_CREATE: session created {{src_ip}}/{{src_port}}->{{dst_ip_public}}/{{dst_port}} {{app}} {{proto_num}}(0) {{policy}} {{zone_src}} {{zone_dst}} {{iface}}",
          "weight": 0.6
        }
      ]
    },
    "fortigate": {
      "display_name": "FortiGate key=value style",
      "default_facility": 23,
      "default_severity_weights": { "critical": 0.25, "error": 0.55, "warning": 0.15, "info": 0.05 },
      "templates": [
        {
          "id": "utm_appctrl_error",
          "envelope": "rfc3164",
          "severity": "error",
          "categories": ["firewall", "security-appliance"],
          "message": "date={{date}} time={{time}} logid=\"0100022920\" type=\"utm\" subtype=\"app-ctrl\" level=\"error\" devid=\"{{device_id}}\" vd=\"root\" eventtime={{eventtime}} tz=\"+0000\" srcip={{src_ip}} srcport={{src_port}} dstip={{dst_ip_public}} dstport={{dst_port}} proto={{proto_num}} service=\"{{app}}\" action=\"blocked\" msg=\"Application control blocked\"",
          "weight": 1.2
        },
        {
          "id": "system_critical",
          "envelope": "rfc3164",
          "severity": "critical",
          "categories": ["firewall", "security-appliance"],
          "message": "date={{date}} time={{time}} logid=\"0100032001\" type=\"event\" subtype=\"system\" level=\"critical\" devid=\"{{device_id}}\" vd=\"root\" eventtime={{eventtime}} tz=\"+0000\" msg=\"CPU usage high\"",
          "weight": 0.6
        }
      ]
    },
    "paloalto": {
      "display_name": "Palo Alto CSV syslog style",
      "default_facility": 23,
      "default_severity_weights": { "critical": 0.20, "error": 0.50, "warning": 0.20, "info": 0.10 },
      "templates": [
        {
          "id": "traffic_csv",
          "envelope": "rfc3164",
          "categories": ["firewall"],
          "message": "{{pa_receive_time}},{{serial}},TRAFFIC,end,{{severity}},{{src_ip}},{{dst_ip_public}},{{src_port}},{{dst_port}},{{proto}},{{action}},{{policy}},{{zone_src}},{{zone_dst}},{{app}},{{url}}",
          "weight": 1.0
        }
      ]
    },
    "f5_bigip": {
      "display_name": "F5 BIG-IP syslog style",
      "default_facility": 16,
      "default_severity_weights": { "critical": 0.20, "error": 0.50, "warning": 0.20, "info": 0.10 },
      "templates": [
        {
          "id": "tmm_caught_signal",
          "envelope": "rfc3164",
          "severity": "error",
          "categories": ["loadbalancer"],
          "message": "notice tmm[{{pid}}]: 01010019:5: Caught signal 2, exiting",
          "weight": 1.0
        },
        {
          "id": "pool_member_down",
          "envelope": "rfc3164",
          "severity": "error",
          "categories": ["loadbalancer"],
          "static_ctx": { "pool": "app_pool_1" },
          "message": "notice mcpd[{{pid}}]: 01070638:5: Pool /Common/{{pool}} member /Common/{{dst_ip_private}}:{{dst_port}} monitor status down.",
          "weight": 1.2
        }
      ]
    },
    "checkpoint": {
      "display_name": "Check Point RFC5424 style",
      "default_facility": 23,
      "default_severity_weights": { "critical": 0.25, "error": 0.55, "warning": 0.15, "info": 0.05 },
      "templates": [
        {
          "id": "cp_drop_rfc5424",
          "envelope": "rfc5424",
          "severity": "error",
          "categories": ["security-appliance", "firewall"],
          "message": "action=Drop rule={{policy}} src={{src_ip}} dst={{dst_ip_public}} spt={{src_port}} dpt={{dst_port}} proto={{proto}} user={{username}}",
          "rfc5424": {
            "app": "cpLogExporter",
            "procid": "-",
            "msgid": "drop",
            "structured_data": "[cp@2620 action=\"Drop\" rule=\"{{policy}}\" src=\"{{src_ip}}\" dst=\"{{dst_ip_public}}\" spt=\"{{src_port}}\" dpt=\"{{dst_port}}\" proto=\"{{proto}}\" user=\"{{username}}\"]"
          },
          "weight": 1.0
        },
        {
          "id": "cp_leef_payload_over_syslog",
          "envelope": "rfc3164",
          "severity": "error",
          "categories": ["security-appliance"],
          "message": "LEEF:2.0|Check Point|Log Exporter|R81|1001|src={{src_ip}}\tdst={{dst_ip_public}}\tsev={{severity_num}}\tusrName={{username}}\tcat={{policy}}\taction={{action}}",
          "weight": 0.6
        }
      ]
    },
    "arista_eos": {
      "display_name": "Arista EOS syslog mnemonics",
      "default_facility": 23,
      "default_severity_weights": { "critical": 0.15, "error": 0.35, "warning": 0.30, "info": 0.20 },
      "templates": [
