    "huawei_vrp": {
      "display_name": "Huawei VRP / CloudEngine / NetEngine",
      "default_facility": 23,
      "default_severity_weights": { "critical": 0.25, "error": 0.35, "warning": 0.30, "info": 0.10 },
      "templates": [
        {
          "id": "ifnet_if_state_down",
          "envelope": "rfc3164",
          "severity": "critical",
          "categories": ["switch", "router"],
          "message": "%%01IFNET/4/IF_STATE(l)[{{pid}}]:Interface {{iface}} has turned into down state.",
