# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is listed in .gitignore — it must never be committed.
#
# setup.sh / setup.ps1 load this automatically before generating
# collector/otel.yaml, so these become the values baked into that file.

# ── Identity ──────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=django-app
OTEL_ENDPOINT=http://localhost:4317

# ── Elasticsearch (optional second export target) ──────────────────────────
ENABLE_ELASTICSEARCH=false
ELASTICSEARCH_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=

# ── OpenObserve (primary backend) ───────────────────────────────────────────
ENABLE_OPENOBSERVE=true
OPENOBSERVE_URL=http://localhost:5080
OO_ORG=default
OO_TRACE_STREAM=apm_traces
OO_LOG_STREAM=apm_logs
OO_USERNAME=admin@example.com
OO_PASSWORD=

LOG_FILE=logs/agent.log
